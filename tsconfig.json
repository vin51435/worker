{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "rootDir": "src",
    "outDir": "dist",

    "baseUrl": "src",
    "paths": {
      "#src/*": ["*"]
    },

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
